default_platform(:ios)

platform :ios do
  desc "Push a new build to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_KEY_ID"],
      issuer_id: ENV["APP_STORE_ISSUER_ID"],
      key_content: ENV["APP_STORE_API_KEY_BASE64"],
      is_key_content_base64: true,
      in_house: false
    )

    create_keychain(
      name: "temporary_keychain",
      password: "temp_password_123!",
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    # Ensure App exists on App Store Connect
    begin
      produce(
        api_key: api_key,
        app_identifier: "com.bibple.chat",
        app_name: "Bibple Chat",
        language: "ko"
      )
    rescue => ex
      UI.message("Produce note: #{ex.message}")
    end

    if ENV["BUILD_CERTIFICATE_BASE64"] && !ENV["BUILD_CERTIFICATE_BASE64"].empty?
      UI.message("Using provided manual certificate...")
      cert_path = "/tmp/cert.p12"
      File.write(cert_path, Base64.decode64(ENV["BUILD_CERTIFICATE_BASE64"]))
      import_certificate(
        certificate_path: cert_path,
        certificate_password: ENV["P12_PASSWORD"] || "",
        keychain_name: "temporary_keychain",
        keychain_password: "temp_password_123!"
      )
    else
      UI.message("Fetching or generating Apple Distribution certificate via API...")
      get_certificates(
        api_key: api_key,
        keychain_name: "temporary_keychain",
        keychain_password: "temp_password_123!"
      )
    end

    if ENV["BUILD_PROVISION_PROFILE_BASE64"] && !ENV["BUILD_PROVISION_PROFILE_BASE64"].empty?
      UI.message("Using provided manual provisioning profile...")
      pp_path = "/tmp/app.mobileprovision"
      File.write(pp_path, Base64.decode64(ENV["BUILD_PROVISION_PROFILE_BASE64"]))
      install_provisioning_profile(path: pp_path)
    else
      UI.message("Fetching or generating App Store provisioning profile via API...")
      get_provisioning_profile(
        api_key: api_key,
        app_identifier: "com.bibple.chat"
      )
    end

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "App.xcodeproj",
      profile_name: lane_context[SharedValues::SIGH_NAME],
      code_sign_identity: "Apple Distribution"
    )

    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "BibpleChat.ipa"
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: "./build/BibpleChat.ipa",
      skip_waiting_for_build_processing: true
    )
  end
end
